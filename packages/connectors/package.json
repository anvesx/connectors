{
  "name": "@anvesx/connectors",
  "version": "0.1.0",
  "description": "A catalog of connector manifests and source adapters (Google Drive, GitHub, Slack, Gmail) with support for custom HTTP connectors.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing/replay": {
      "types": "./dist/tests/support/replay.d.ts",
      "default": "./dist/tests/support/replay.js"
    },
    "./testing/drive-server": {
      "types": "./dist/tests/support/drive-server.d.ts",
      "default": "./dist/tests/support/drive-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R tests/fixtures dist/tests/fixtures",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@googleapis/drive": "27.0.0",
    "@googleapis/gmail": "^22.0.2",
    "@octokit/rest": "22.0.1",
    "@slack/web-api": "^8.3.0"
  },
  "peerDependencies": {
    "@anvesx/connector-kit": ">=0.1.0",
    "@anvesx/core-types": ">=0.1.0"
  },
  "devDependencies": {
    "@anvesx/connector-kit": "link:../../../company-brain/features/connector-kit",
    "@anvesx/core-types": "link:../../../company-brain/features/core-types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvesx/connectors.git",
    "directory": "packages/connectors"
  },
  "license": "MIT"
}
