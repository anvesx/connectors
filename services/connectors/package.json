{
  "name": "@anvesx/connectors",
  "version": "0.1.0",
  "description": "A catalog of connector manifests and source adapters (Google Drive, GitHub, Slack, Gmail) with support for custom HTTP connectors.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing/replay": {
      "types": "./dist/src/testing/replay.d.ts",
      "default": "./dist/src/testing/replay.js"
    },
    "./testing/drive-server": {
      "types": "./dist/src/testing/drive-server.d.ts",
      "default": "./dist/src/testing/drive-server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/tests && cp -R tests/fixtures dist/tests/fixtures",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@googleapis/drive": "27.0.0",
    "@googleapis/gmail": "^22.0.2",
    "@octokit/plugin-retry": "8.1.1",
    "@octokit/plugin-throttling": "11.0.5",
    "@octokit/rest": "22.0.1",
    "@slack/web-api": "^8.3.0"
  },
  "peerDependencies": {
    "@anvesx/connector-kit": ">=0.1.0",
    "@anvesx/core-types": ">=0.1.0"
  },
  "devDependencies": {
    "@anvesx/connector-kit": "0.1.0",
    "@anvesx/core-types": "0.1.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvesx/connectors.git",
    "directory": "services/connectors"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  }
}
